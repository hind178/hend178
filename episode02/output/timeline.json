 "duration": 115.9575,
 "narration": [
  {
   "line": 1,
   "start": 0,
   "end": 3.02,
   "text": "الفندق خصص لكل طالبتين غرفة…"
  },
  {
   "line": 2,
   "start": 4.5,
   "end": 8.75,
   "text": "بس لورين رفضت تدخل غرفتها قبل ما تحل مشكلة هند!"
  },
  {
   "line": 3,
   "start": 9.44,
   "end": 12.52,
   "text": "من وصلن للفندق، الجامعة بدت توزّع الغرف."
  },
  {
   "line": 4,
   "start": 13.09,
   "end": 14.66,
   "text": "كل طالبتين بغرفة وحدة."
  },
  {
   "line": 5,
   "start": 15.52,
   "end": 20.15,
   "text": "هند توقعت إن لورين وليزيت راح يبقن سوه، وهي تروح لغرفة ثانية."
  },
  {
   "line": 6,
   "start": 20.83,
   "end": 21.49,
   "text": "فگالت:"
  },
  {
   "line": 7,
   "start": 21.97,
   "end": 25.59,
   "text": "«لورين، عادي حبيبتي، آني أبقى ويا أي بنت ثانية.»"
  },
  {
   "line": 8,
   "start": 26.31,
   "end": 29.52,
   "text": "مو لأن هند ما چانت تريد تبقى وياهن، بالعكس!"
  },
  {
   "line": 9,
   "start": 29.91,
   "end": 34.86,
   "text": "بس چانت تخاف تكون حمل ثقيل عليهن، أو تاخذ من خصوصيتهن."
  },
  {
   "line": 10,
   "start": 36,
   "end": 37.57,
   "text": "لورين باوعت عليها وگالت:"
  },
  {
   "line": 11,
   "start": 38.08,
   "end": 40.47,
   "text": "«شلون يعني؟ إحنا ثلاثتنا نبقى سوه!»"
  },
  {
   "line": 12,
   "start": 41.35,
   "end": 44.55,
   "text": "وراحت هي وليزيت وهند، وجابن دوشگ كبير."
  },
  {
   "line": 13,
   "start": 45.23,
   "end": 48.55,
   "text": "قرّبن السريرين من بعض، وحطن الدوشگ فوقهن."
  },
  {
   "line": 14,
   "start": 48.96,
   "end": 53.41,
   "text": "وصارت الغرفة اللي مخصصة لبنتين، غرفة لثلاث صديقات!"
  },
  {
   "line": 15,
   "start": 54.18,
   "end": 57.17,
   "text": "ضحكن وسولفن واستمتعن بوقتهن."
  },
  {
   "line": 16,
   "start": 58.1,
   "end": 62.57,
   "text": "وباليوم الثاني، من رجعن للفندق، هند بدّلت ملابسها حتى ترتاح."
  },
  {
   "line": 17,
   "start": 63.22,
   "end": 64.34,
   "text": "إجت لورين وگالت:"
  },
  {
   "line": 18,
   "start": 64.87,
   "end": 67.25,
   "text": "«هند! يلا نطلع نجيب أكل وبقلاوة!»"
  },
  {
   "line": 19,
   "start": 68.14,
   "end": 68.86,
   "text": "هند گالت:"
  },
  {
   "line": 20,
   "start": 69.38,
   "end": 71.78,
   "text": "«آني بدّلت ملابسي، روحن إنتن، عادي.»"
  },
  {
   "line": 21,
   "start": 72.66,
   "end": 73.73,
   "text": "لورين ردّت عليها:"
  },
  {
   "line": 22,
   "start": 74.16,
   "end": 78.26,
   "text": "«مستحيل نطلع ونخليچ وحدچ! البسي أي شي وتعالي ويانا.»"
  },
  {
   "line": 23,
   "start": 79.19,
   "end": 86.19,
   "text": "وبالفعل، طلعن وجابن بيتزا وبقلاوة، وصارت وياهن مواقف ضحكن عليها طول الطريق."
  },
  {
   "line": 24,
   "start": 86.81,
   "end": 91.88,
   "text": "ومع كل موقف، چانت المسافة بينهن تصغر، وصداقتهن تكبر."
  },
  {
   "line": 25,
   "start": 93,
   "end": 98.99,
   "text": "هند چانت تحس إن لورين تعاملها مثل أختها الصغيرة، وتنتبه حتى لأبسط تفاصيلها."
  },
  {
   "line": 26,
   "start": 99.79,
   "end": 104.94,
   "text": "ولأول مرة بهالسفرة، هند نسيت تمامًا إنها إجت بدون صديقاتها."
  },
  {
   "line": 27,
   "start": 106.34,
   "end": 111.31,
   "text": "بس باليوم الأخير، هند اقترحت عليهن يجربن لعبة بمدينة الألعاب…"
  },
  {
   "line": 28,
   "start": 112.47,
   "end": 115.6,
   "text": "اقتراح خلّاها تندم من كل قلبها!"
  }
 ],
