{
 "episode": "01",
 "title": "سفرة ما چانت بالحسبان",
 "fps": 30,
 "resolution": [
  1080,
  1920
 ],
 "duration": 107.075875,
 "narration": [
  {
   "line": 1,
   "start": 0,
   "end": 5.86,
   "text": "هند راحت بسفرة جامعية مدتها خمسة أيام، وهي متوقعة تقضيها وحدها…"
  },
  {
   "line": 2,
   "start": 7.06,
   "end": 13.72,
   "text": "بس تصرّف بنت ما چانت حتى من صديقاتها المقربات، غيّر كل توقعاتها!"
  },
  {
   "line": 3,
   "start": 15.36,
   "end": 17.42,
   "text": "هند چانت بالمرحلة الثالثة بالجامعة."
  },
  {
   "line": 4,
   "start": 17.86,
   "end": 23.15,
   "text": "ولأنها چانت من الأوائل بالمعهد، دخلت الكلية مباشرة من المرحلة الثانية."
  },
  {
   "line": 5,
   "start": 23.89,
   "end": 27.72,
   "text": "ولهذا، ما چان عندها وقت طويل حتى تتعرف على زملائها."
  },
  {
   "line": 6,
   "start": 28.44,
   "end": 34.23,
   "text": "وبالمرحلة الثالثة، الجامعة نظّمت سفرة علمية لمدة خمسة أيام خارج المدينة."
  },
  {
   "line": 7,
   "start": 35.35,
   "end": 38.14,
   "text": "بس صديقات هند الثنتين قررن ما يروحن."
  },
  {
   "line": 8,
   "start": 38.73,
   "end": 43.71,
   "text": "ومن بين الطالبات اللي راحن، چانت أكو بنت اسمها لورين، وصديقتها ليزيت."
  },
  {
   "line": 9,
   "start": 44.46,
   "end": 50.15,
   "text": "هذني الثنتين چانن مقربات لدرجة مستحيل تشوف وحدة منهن بدون الثانية."
  },
  {
   "line": 10,
   "start": 50.71,
   "end": 53.54,
   "text": "وكل الكلية چانت تحچي عن صداقتهن."
  },
  {
   "line": 11,
   "start": 54.27,
   "end": 57.65,
   "text": "أما علاقتهن بهند، فچانت مجرد علاقة زمالة."
  },
  {
   "line": 12,
   "start": 58.38,
   "end": 61.25,
   "text": "وهند بطبعها ما تحب تفرض نفسها على أحد."
  },
  {
   "line": 13,
   "start": 61.94,
   "end": 65.06,
   "text": "فهيأت نفسها إنها تقضي أغلب السفرة وحدها."
  },
  {
   "line": 14,
   "start": 66.28,
   "end": 71.25,
   "text": "بس من وصلت لباب الجامعة، تفاجأت بلورين وهي تستقبلها بفرحة كبيرة:"
  },
  {
   "line": 15,
   "start": 72.4,
   "end": 76.03,
   "text": "هند! إنتِ هم جاية؟ شكد فرحت من شفتچ!"
  },
  {
   "line": 16,
   "start": 76.79,
   "end": 78.82,
   "text": "ومن صعدن للسيارة، گالت لورين:"
  },
  {
   "line": 17,
   "start": 79.49,
   "end": 83.88,
   "text": "كل مرة نبدّل أماكننا، مرة آني أگعد يم هند، ومرة ليزيت تگعد يمها."
  },
  {
   "line": 18,
   "start": 84.84,
   "end": 86.04,
   "text": "هند استغربت وگالت:"
  },
  {
   "line": 19,
   "start": 86.51,
   "end": 90.67,
   "text": "لا لورين، إنتن صديقات ومقربات، عادي آني أگعد وحدي."
  },
  {
   "line": 20,
   "start": 91.64,
   "end": 92.85,
   "text": "بس لورين ما قبلت."
  },
  {
   "line": 21,
   "start": 93.57,
   "end": 98.81,
   "text": "ومن هذيچ اللحظة، بدت هند تكتشف جانب من شخصية لورين ما چانت تعرفه."
  },
  {
   "line": 22,
   "start": 100.3,
   "end": 105.6,
   "text": "بس اللي سوّته لورين من وصلن للفندق، خلّى هند تعرف إن الموضوع مو مجرد مجاملة!"
  },
  {
   "line": 23,
   "start": 105.6,
   "end": 106.9,
   "text": "يتبع…"
  }
 ],
